# ---------- 币安 WebSocket ----------
BINANCE_WS_BASE=wss://fstream.binance.com/ws
BINANCE_WS_HANDSHAKE_MS=20000
# 完整订阅地址
# 备用1: wss://fstream.binance.com/market/stream?streams=btcusdt@markPrice@1s
# 备用2: wss://fstream.binance.com/stream?streams=btcusdt@markPrice@1s
# 备用3: wss://fstream.binance.com/ws/btcusdt@markPrice@1s
BINANCE_WS_URL=wss://fstream.binance.com/market/ws/btcusdt@markPrice@1s

# ---------- 交易 Webhook ----------
WEBHOOK_URL=https://trading.24os.cn/webhook/wh_d113d9b4d838dbd635d4c19c3f0c51d9

# ---------- 飞书通知 ----------
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/cbbf7949-e7f5-4dd6-a257-d6e018ae563c
FEISHU_WEBHOOK_SECRET=IVO6tQ1vjxOyALOCPvZN5d

# ---------- 交易参数 ----------
POSITION_SIZE=3
LEVERAGE=100
MAX_RISK_PER_TRADE=2
MAX_DAILY_LOSS=6
MAX_CONSECUTIVE_LOSSES=3

# ---------- 服务器 ----------
PORT=3000

# ---------- 回测默认 ----------
BACKTEST_INITIAL_CAPITAL=10000
BACKTEST_FEE_RATE=0.0004

# ---------- 网络（国内访问 fapi.binance.com 时建议配置）----------
# ccxt 超时（毫秒）
CCXT_TIMEOUT_MS=60000
# 若需走代理，取消注释并改为你的代理地址：
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
